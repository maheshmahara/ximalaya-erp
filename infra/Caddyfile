{
    admin off
    auto_https off
}

:80, :55555, http://103.254.186.194:55555, http://192.168.5.109:55555 {
    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # API Documentation & Health Check
    handle /healthz {
        reverse_proxy api:8000
    }
    handle /docs* {
        reverse_proxy api:8000
    }
    handle /redoc* {
        reverse_proxy api:8000
    }
    handle /openapi.json {
        reverse_proxy api:8000
    }

    # API Endpoints (All backend logic sits strictly under /api/)
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /spatial/* {
        reverse_proxy api:8000
    }

    # WebSocket Streams (Telemetry)
    handle /ws/* {
        reverse_proxy api:8000
    }

    # All UI Routes & Static Assets -> Next.js 14
    handle {
        reverse_proxy web:3000
    }
}
