{
    auto_https off
    admin off
}

:80 {
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Handle public traceability requests
    handle /traceability/* {
        reverse_proxy api:8000
    }

    # Handle API, Swagger docs, health, spatial, and websockets
    handle /api/* {
        reverse_proxy api:8000
    }

    handle /docs* {
        reverse_proxy api:8000
    }

    handle /openapi.json {
        reverse_proxy api:8000
    }

    handle /healthz {
        reverse_proxy api:8000
    }

    handle /spatial/* {
        reverse_proxy api:8000
    }

    handle /ws/* {
        reverse_proxy api:8000
    }

    # Fallback to Next.js Web UI
    handle {
        reverse_proxy web:3000
    }
}
